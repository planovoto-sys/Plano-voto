rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validEstado(estado) {
      return estado == null || estado in [
        'AC',
        'AL',
        'AM',
        'AP',
        'BA',
        'CE',
        'DF',
        'ES',
        'GO',
        'MA',
        'MG',
        'MS',
        'MT',
        'PA',
        'PB',
        'PE',
        'PI',
        'PR',
        'RJ',
        'RN',
        'RO',
        'RR',
        'RS',
        'SC',
        'SE',
        'SP',
        'TO'
      ];
    }

    function validVoterProfile() {
      return request.resource.data.role == 'voter'
        && validEstado(request.resource.data.estado)
        && request.resource.data.email == request.auth.token.email;
    }

    function validBallotDraft(userId) {
      return request.resource.data.keys().hasOnly([
        'schema_version',
        'election_id',
        'user_id',
        'estado',
        'selections',
        'candidate_groups',
        'completed_steps',
        'active_candidate_ids',
        'updated_at'
      ])
      && request.resource.data.schema_version == 1
      && request.resource.data.election_id == 'congresso-2026'
      && request.resource.data.user_id == userId
      && validEstado(request.resource.data.estado)
      && request.resource.data.selections is map
      && request.resource.data.candidate_groups is map
      && request.resource.data.completed_steps is map
      && request.resource.data.active_candidate_ids is list
      && request.resource.data.active_candidate_ids.size() <= 3;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'created_at'
        ])
        && validVoterProfile();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'last_login_at',
          'updated_at',
          'candidatos_escolhidos'
          ])
          && !('candidatos_escolhidos' in request.resource.data)
          && validVoterProfile()
        );

      allow delete: if isAdmin();
    }

    match /candidatos/{candidateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /elections/{electionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /eligibility/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /votes/{voteId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }

      match /ballot_drafts/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isOwner(userId) && validBallotDraft(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /candidate_tallies/{candidateId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /plan_handoff_tokens/{tokenId} {
        allow read, write: if false;
      }

      match /audit_events/{eventId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
