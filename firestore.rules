rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validEstado(estado) {
      return estado == null || estado in [
        'AC',
        'AL',
        'AM',
        'AP',
        'BA',
        'CE',
        'DF',
        'ES',
        'GO',
        'MA',
        'MG',
        'MS',
        'MT',
        'PA',
        'PB',
        'PE',
        'PI',
        'PR',
        'RJ',
        'RN',
        'RO',
        'RR',
        'RS',
        'SC',
        'SE',
        'SP',
        'TO'
      ];
    }

    function validVoterProfile() {
      return request.resource.data.role == 'voter'
        && validEstado(request.resource.data.estado)
        && request.resource.data.email == request.auth.token.email;
    }

    function choiceConfigPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/private/choiceConfig;
    }

    function validChoiceConfigCreate() {
      return request.resource.data.keys().hasOnly([
          'choiceDocId',
          'createdAt'
        ])
        && request.resource.data.choiceDocId is string
        && request.resource.data.choiceDocId.size() >= 20
        && request.resource.data.createdAt == request.time;
    }

    function ownsChoiceDoc(choiceDocId) {
      return signedIn()
        && (
          (
            exists(choiceConfigPath(request.auth.uid))
            && get(choiceConfigPath(request.auth.uid)).data.choiceDocId == choiceDocId
          )
          || getAfter(choiceConfigPath(request.auth.uid)).data.choiceDocId == choiceDocId
        );
    }

    function validPublicCandidateChoice(choiceDocId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'electionId',
          'state',
          'candidateIds',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.electionId is string
        && request.resource.data.state is string
        && validEstado(request.resource.data.state)
        && request.resource.data.candidateIds is list
        && request.resource.data.candidateIds.size() <= 100
        && request.resource.data.updatedAt == request.time
        && ownsChoiceDoc(choiceDocId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'created_at'
        ])
        && validVoterProfile();

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'last_login_at',
          'updated_at',
          'candidatos_escolhidos'
          ])
          && !('candidatos_escolhidos' in request.resource.data)
          && validVoterProfile()
        );

      allow delete: if isAdmin();

      match /private/{privateDocId} {
        allow read: if privateDocId == 'choiceConfig' && isOwner(userId);
        allow create: if privateDocId == 'choiceConfig'
          && isOwner(userId)
          && validChoiceConfigCreate();
        allow update, delete: if false;
      }
    }

    match /candidatos/{candidateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /partidos_politicos/{partyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicCandidateChoices/{choiceDocId} {
      allow read: if true;
      allow create, update: if validPublicCandidateChoice(choiceDocId);
      allow delete: if false;
    }

    match /elections/{electionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /eligibility/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /votes/{voteId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }

      match /ballot_drafts/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update, delete: if false;
      }

      match /candidate_tallies/{candidateId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /plan_handoff_tokens/{tokenId} {
        allow read, write: if false;
      }

      match /audit_events/{eventId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
