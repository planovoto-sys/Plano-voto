rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function activeElectionId() {
      return 'congresso-2026';
    }

    function voteLockPath(electionId, userId) {
      return /databases/$(database)/documents/elections/$(electionId)/votes_realized/$(userId);
    }

    function voteLockCreatedInThisCommit(electionId, userId) {
      return signedIn()
        && userId == request.auth.uid
        && !exists(voteLockPath(electionId, userId))
        && getAfter(voteLockPath(electionId, userId)).data.election_id == electionId
        && getAfter(voteLockPath(electionId, userId)).data.user_id == userId
        && getAfter(voteLockPath(electionId, userId)).data.created_at == request.time;
    }

    function candidateVoteIncremented() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votos_recebidos'])
        && (
          ('votos_recebidos' in resource.data
            && request.resource.data.votos_recebidos == resource.data.votos_recebidos + 1)
          || (!('votos_recebidos' in resource.data)
            && request.resource.data.votos_recebidos == 1)
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'created_at'
        ])
        && request.resource.data.role == 'voter';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'email',
            'profile_image',
            'estado',
            'role',
            'schema_version',
            'last_login_at',
            'updated_at',
            'candidatos_escolhidos'
          ])
          && !('candidatos_escolhidos' in request.resource.data)
          && request.resource.data.role == 'voter'
        );

      allow delete: if isAdmin();
    }

    match /candidatos/{candidateId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && voteLockCreatedInThisCommit(activeElectionId(), request.auth.uid)
          && candidateVoteIncremented()
        );
    }

    match /elections/{electionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Legacy support: read-only for voters, full control only for admins.
      match /eligibility/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Lock collection: doc id is auth.uid. Stores only lock metadata.
      match /votes_realized/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();

        allow create: if isOwner(userId)
          && electionId == activeElectionId()
          && request.resource.data.keys().hasOnly([
            'schema_version',
            'election_id',
            'user_id',
            'created_at'
          ])
          && request.resource.data.election_id == electionId
          && request.resource.data.user_id == userId
          && request.resource.data.created_at == request.time;

        allow update: if false;
        allow delete: if isAdmin();
      }

      // Anonymous votes: no uid, email, or voter identifier allowed.
      match /votes_anonymous/{voteId} {
        allow create: if signedIn()
          && electionId == activeElectionId()
          && voteLockCreatedInThisCommit(electionId, request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'schema_version',
            'election_id',
            'estado',
            'offices',
            'candidate_ids',
            'submitted_at',
            'source'
          ])
          && request.resource.data.election_id == electionId
          && request.resource.data.submitted_at == request.time
          && request.resource.data.candidate_ids is list
          && request.resource.data.candidate_ids.size() == 3
          && request.resource.data.offices is map;

        allow read, update, delete: if isAdmin();
      }

      match /candidate_tallies/{candidateId} {
        allow read: if true;

        allow create: if signedIn()
          && electionId == activeElectionId()
          && voteLockCreatedInThisCommit(electionId, request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'schema_version',
            'election_id',
            'candidate_id',
            'total_votes',
            'updated_at'
          ])
          && request.resource.data.election_id == electionId
          && request.resource.data.candidate_id == candidateId
          && request.resource.data.total_votes == 1
          && request.resource.data.updated_at == request.time;

        allow update: if signedIn()
          && electionId == activeElectionId()
          && voteLockCreatedInThisCommit(electionId, request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'total_votes',
            'updated_at'
          ])
          && request.resource.data.total_votes == resource.data.total_votes + 1
          && request.resource.data.updated_at == request.time;

        allow delete: if isAdmin();
      }

      match /audit_events/{eventId} {
        allow create: if signedIn()
          && electionId == activeElectionId()
          && voteLockCreatedInThisCommit(electionId, request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'schema_version',
            'election_id',
            'event_type',
            'created_at',
            'source'
          ])
          && request.resource.data.election_id == electionId
          && request.resource.data.event_type == 'anonymous_vote_cast'
          && request.resource.data.created_at == request.time;

        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
