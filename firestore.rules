rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isActiveElection(electionId) {
      return electionId == 'congresso-2026';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /private/{privateDocId} {
        allow read, write: if false;
      }
    }

    match /candidatos/{candidateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /partidos_politicos/{partyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publicCandidateChoices/{choiceDocId} {
      allow read, write: if false;
    }

    match /elections/{electionId} {
      allow get: if isActiveElection(electionId);
      allow list: if false;
      allow create, update, delete: if isAdmin();

      match /eligibility/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /votes/{voteId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }

      match /ballot_drafts/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update, delete: if false;
      }

      match /candidate_tallies/{candidateId} {
        allow read: if isActiveElection(electionId);
        allow create, update, delete: if isAdmin();
      }

      match /selection_tallies/{tallyId} {
        allow read: if isActiveElection(electionId);
        allow create, update, delete: if isAdmin();
      }

      match /state_choice_metrics/{stateId} {
        allow read: if isActiveElection(electionId);
        allow create, update, delete: if isAdmin();
      }

      match /plan_handoff_tokens/{tokenId} {
        allow read, write: if false;
      }

      match /audit_events/{eventId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
