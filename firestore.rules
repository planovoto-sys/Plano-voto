rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'created_at'
        ])
        && request.resource.data.role == 'voter';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'email',
          'profile_image',
          'estado',
          'role',
          'schema_version',
          'last_login_at',
          'updated_at',
          'candidatos_escolhidos'
          ])
          && !('candidatos_escolhidos' in request.resource.data)
          && request.resource.data.role == 'voter'
        );

      allow delete: if isAdmin();
    }

    match /candidatos/{candidateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /elections/{electionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /eligibility/{userId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isAdmin();
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /votes/{voteId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }

      match /candidate_tallies/{candidateId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      match /audit_events/{eventId} {
        allow create: if false;
        allow read, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
