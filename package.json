{
  "name": "plano-mvp",
  "private": true,
  "version": "1.11.4",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "lint": "eslint .",
    "test": "node --test tests/candidateMetrics.test.mjs tests/devApiProxy.test.mjs tests/googleIdentity.test.mjs tests/recommendationsDatabase.test.mjs tests/rpcErrorMapping.test.mjs tests/serverConfiguration.test.mjs tests/sharedSelectionModel.test.mjs tests/summaryCandidates.test.mjs tests/supabaseCandidateImport.test.mjs tests/supabaseConfiguration.test.mjs tests/supabaseScoreUpdate.test.mjs tests/viabilityTargets.test.mjs tests/whatsappInvite.test.mjs",
    "security:secrets": "node scripts/security-audit.mjs",
    "security:dependencies": "npm audit --audit-level=high && npm audit --prefix functions --audit-level=high",
    "security:audit": "npm run security:secrets && npm run security:dependencies",
    "preview": "vite preview",
    "candidates:cleanup-placeholders": "node scripts/delete-placeholder-candidates.mjs",
    "candidates:import": "node scripts/import-candidates-2026.mjs",
    "candidates:update-numbers": "node scripts/update-candidate-numbers.mjs",
    "candidates:update-scores": "node scripts/update-candidate-scores.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:lint": "supabase db lint --local --level warning",
    "supabase:db:push": "supabase db push",
    "supabase:types": "supabase gen types typescript --local > src/shared/supabase/database.types.ts",
    "supabase:candidates:import": "node scripts/import-supabase-candidates-2026.mjs",
    "supabase:scores:update": "node scripts/update-supabase-scores.mjs",
    "predeploy": "npm run build",
    "deploy": "npx gh-pages -d dist",
    "deploy:firebase-rules": "npx firebase-tools deploy --only firestore:rules,storage --project plano-mvp-9a0b4",
    "audit:functions": "npm audit --prefix functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "firebase": "^12.12.1",
    "firebase-admin": "^14.3.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-firebase-hooks": "^5.1.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
