# A chave Web do Firebase identifica o projeto no cliente e nao e um segredo.
# Restrinja-a por dominio/API no Google Cloud e habilite o App Check.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1
VITE_ACTIVE_ELECTION_ID=congresso-2026
VITE_CAST_VOTE_FUNCTION=castAnonymousVote
VITE_DELETE_USER_ELECTION_DATA_FUNCTION=deleteUserElectionData
VITE_CREATE_PLAN_HANDOFF_TOKEN_FUNCTION=createPlanHandoffToken
VITE_REDEEM_PLAN_HANDOFF_TOKEN_FUNCTION=redeemPlanHandoffToken
VITE_SAVE_BALLOT_STATE_FUNCTION=saveBallotState
VITE_SAVE_BALLOT_STEP_FUNCTION=saveBallotStepSelection
