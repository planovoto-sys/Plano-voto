# A chave Web do Firebase identifica o projeto no cliente e nao e um segredo.
# Restrinja-a por dominio e por API no Google Cloud.
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
VITE_MEASUREMENT_ID=
VITE_ACTIVE_ELECTION_ID=congresso-2026

# Cliente Supabase. A publishable key e publica e pode usar prefixo VITE_.
# Para o stack local, obtenha os valores com `npm run supabase:status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos/CLI que ainda fornecem a chave anon legada.
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_PROVIDER=supabase
VITE_CANDIDATE_PROVIDER=supabase
# ID publico do cliente Web no Google Auth Platform. Habilita o login direto sem
# redirecionar o usuario para o dominio tecnico <project-ref>.supabase.co.
VITE_GOOGLE_CLIENT_ID=

# Obrigatorio para `npm run dev` e usado apenas pelo servidor Vite.
# Definir a origem e uma confirmacao explicita: gravacoes alteram o backend indicado.
# Nao entra no bundle do navegador.
PLANO_VOTO_DEV_API_ORIGIN=https://bomdevoto.com.br

# Somente no ambiente protegido da API da Vercel. Nunca use prefixo VITE_:
FIREBASE_SERVICE_ACCOUNT_BASE64=
BALLOT_ENCRYPTION_KEY=

# Somente no backend. Nunca exponha a service role com prefixo VITE_.
SUPABASE_URL=
# Formato atual recomendado pelo Supabase (sb_secret_...).
SUPABASE_SECRET_KEY=
# Compatibilidade com projetos que ainda usam service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# OAuth Google local do Supabase. Grave os valores em supabase/.env.local.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
